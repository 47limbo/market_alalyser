# Copy this file to .env (same folder as run.py) and fill in the keys you want. Both are optional.
# .env is never uploaded to GitHub.

# Not needed: earnings come from Yahoo Finance and SEC filings without a key.
# Free key from https://finnhub.io/register if you would rather use Finnhub for earnings dates and EPS.
FINNHUB_API_KEY=

# Key from https://console.anthropic.com/ : turns on the Deep research button (Claude searches the web
# and writes a cited brief). Each run uses API credit, roughly $0.25 to $1.50 (up to 10 web searches at
# 1 cent each, plus the reading and writing). Set a monthly spend limit in the console to be safe.
ANTHROPIC_API_KEY=
